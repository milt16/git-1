

        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from mpl_toolkits.mplot3d import Axes3D\n",
        "import math\n",
        "\n",
        "# Константы\n",
        "MU0 = 4 * math.pi * 1e-7  # Магнитная постоянная, Гн/м (µ0 - \"мю нулевое\")\n",
        "\n",
        "\n",
        "# Функция для создания спирали\n",
        "\n",
        "def generate_spiral(R, h, N_vitkov, N_points):\n",
        "    \"\"\"\n",
        "    Генерация координат спирали\n",
        "    R - радиус витка (м) - насколько далеко проволока от центра\n",
        "    h - шаг спирали (м) - расстояние между соседними витками\n",
        "    N_vitkov - число витков - сколько раз проволока оборачивается вокруг оси\n",
        "    N_points - число точек для аппроксимации - из скольких кусочков состоит спираль\n",
        "\n",
        "    Математика: спираль задаётся параметрически:\n",
        "    x = R * cos(t) - точка бежит по окружности (косинус даёт координату X)\n",
        "    y = R * sin(t) - синус даёт координату Y (вместе с cos получается окружность)\n",
        "    z = h * t - а Z линейно растёт, поэтому получается не плоское кольцо, а спираль\n",
        "    t меняется от 0 до 2π * число витков (полный оборот = 2π радиан = 360 градусов)\n",
        "    \"\"\"\n",
        "    # Создаём массив значений угла t от 0 до 2π * число витков\n",
        "    # Например, если 3 витка, то t от 0 до ~18.85 (6π)\n",
        "    t = np.linspace(0, 2*np.pi*N_vitkov, N_points)\n",
        "\n",
        "    # Вычисляем координаты по формулам спирали\n",
        "    x = R * np.cos(t)  # X меняется по косинусу - движение по окружности\n",
        "    y = R * np.sin(t)  # Y меняется по синусу - движение по окружности\n",
        "    z = h * t          # Z растёт пропорционально углу - подъём спирали\n",
        "\n",
        "    # Объединяем x, y, z в один массив, где каждая строка - одна точка (x, y, z)\n",
        "    # Это стандартный формат для хранения 3D координат\n",
        "    return np.column_stack((x, y, z))\n",
        "\n",
        "\n",
        "# Функция для расчёта поля от одного маленького отрезка провода\n",
        "\n",
        "def biot_savart_segment(dl, r_prime, r, I):\n",
        "    \"\"\"\n",
        "    Вклад в магнитное поле от одного отрезка по закону Био-Савара-Лапласа\n",
        "\n",
        "    dl - вектор длины отрезка (направление тока и длина кусочка провода)\n",
        "    r_prime - координаты центра отрезка (где находится этот кусочек)\n",
        "    r - координаты точки наблюдения (где мы хотим узнать поле)\n",
        "    I - сила тока (сколько ампер течёт по проводу)\n",
        "\n",
        "    Закон Био-Савара-Лапласа (упрощённо):\n",
        "    Маленький кусочек провода с током создаёт магнитное поле, которое:\n",
        "    1. Пропорционально току I\n",
        "    2. Пропорционально длине отрезка |dl|\n",
        "    3. Направлено перпендикулярно и отрезку, и линии от отрезка к точке\n",
        "    4. Убывает с расстоянием как 1/r² (в формуле r³ из-за математики)\n",
        "    \"\"\"\n",
        "    # Вектор от центра отрезка до точки наблюдения\n",
        "    r_vec = r - r_prime\n",
        "\n",
        "    # Расстояние от отрезка до точки (длина вектора r_vec)\n",
        "    r_mag = np.linalg.norm(r_vec)\n",
        "\n",
        "    # Защита от деления на ноль: если точка слишком близко к проводу\n",
        "    if r_mag < 1e-6:  # 1e-6 метра = 1 микрометр\n",
        "        return np.zeros(3)  # возвращаем нулевое поле\n",
        "\n",
        "    # Векторное произведение dl × r_vec - это ключевая часть формулы\n",
        "    # Оно даёт направление поля: перпендикулярно и dl, и r_vec\n",
        "    cross_product = np.cross(dl, r_vec)\n",
        "\n",
        "    # Финальная формула закона Био-Савара-Лапласа\n",
        "    # MU0 * I / (4π) - константы и ток\n",
        "    # cross_product - определяет направление\n",
        "    # / r_mag**3 - поле убывает с расстоянием\n",
        "    return MU0 * I / (4 * np.pi) * cross_product / (r_mag**3)\n",
        "\n",
        "\n",
        "# Функция для расчёта поля от всей спирали\n",
        "\n",
        "def magnetic_field_spiral(R, h, N_vitkov, I, points, N_segments=500):\n",
        "    \"\"\"\n",
        "    Расчёт магнитного поля спирали в заданных точках\n",
        "\n",
        "    R, h, N_vitkov - параметры спирали (см. generate_spiral)\n",
        "    I - сила тока\n",
        "    points - массив точек, в которых нужно посчитать поле (каждая строка - точка x,y,z)\n",
        "    N_segments - на сколько отрезков разбить спираль (чем больше, тем точнее, но медленнее)\n",
        "\n",
        "    Принцип: разбиваем спираль на маленькие отрезки,\n",
        "    для каждого отрезка считаем поле в каждой точке наблюдения,\n",
        "    суммируем все вклады (принцип суперпозиции)\n",
        "    \"\"\"\n",
        "    # Сначала создаём спираль из N_segments точек\n",
        "    spiral = generate_spiral(R, h, N_vitkov, N_segments)\n",
        "\n",
        "    # Создаём массив для результатов такой же формы, как points\n",
        "    # Изначально заполняем нулями\n",
        "    B_total = np.zeros_like(points)\n",
        "\n",
        "    # Проходим по всем отрезкам спирали\n",
        "    # Отрезков будет на 1 меньше, чем точек (последняя точка не образует отрезок)\n",
        "    for i in range(len(spiral)-1):\n",
        "        # Вектор текущего отрезка (от точки i до точки i+1)\n",
        "        dl = spiral[i+1] - spiral[i]\n",
        "\n",
        "        # Центр отрезка (среднее между началом и концом)\n",
        "        r_prime = (spiral[i] + spiral[i+1]) / 2\n",
        "\n",
        "        # Для каждой точки наблюдения считаем вклад от этого отрезка\n",
        "        for j, point in enumerate(points):\n",
        "            # Добавляем вклад к общему полю в этой точке\n",
        "            B_total[j] += biot_savart_segment(dl, r_prime, point, I)\n",
        "\n",
        "    return B_total\n",
        "\n",
        "\n",
        "# Главная функция для визуализации\n",
        "\n",
        "def plot_magnetic_field(R, h, N_vitkov, I, grid_size=15):\n",
        "    \"\"\"\n",
        "    Построение 3D визуализации магнитного поля спирали\n",
        "\n",
        "    Параметры по умолчанию:\n",
        "    R = 0.02 м = 2 см (радиус как у небольшой пружинки)\n",
        "    h = 0.005 м = 0.5 см (шаг - полсантиметра между витками)\n",
        "    N_vitkov = 3 (три витка)\n",
        "    I = 5 А (ток 5 ампер - как в мощном блоке питания)\n",
        "    grid_size = 15 (сетка 15×15×15 точек для визуализации)\n",
        "    \"\"\"\n",
        "\n",
        "    # 1. Подготовка данных: создаём сетку точек для расчёта поля\n",
        "\n",
        "    # Создаём равномерные координаты по каждой оси\n",
        "    x = np.linspace(-0.05, 0.05, grid_size)  # от -5 см до +5 см по X\n",
        "    y = np.linspace(-0.05, 0.05, grid_size)  # от -5 см до +5 см по Y\n",
        "    z = np.linspace(-0.02, 0.02, grid_size)  # от -2 см до +2 см по Z (спираль выше, но нас интересует центр)\n",
        "\n",
        "    # Создаём 3D сетку координат (три массива, задающие все точки куба)\n",
        "    X, Y, Z = np.meshgrid(x, y, z)\n",
        "\n",
        "    # Преобразуем сетку в список точек: каждая строка - (x, y, z) одной точки\n",
        "    # Всего будет grid_size³ точек (например, 15³ = 3375 точек)\n",
        "    points = np.column_stack((X.ravel(), Y.ravel(), Z.ravel()))\n",
        "\n",
        "    print(\"Расчет магнитного поля...\")\n",
        "    print(f\"  Сетка: {grid_size}×{grid_size}×{grid_size} = {len(points)} точек\")\n",
        "    print(f\"  Параметры спирали: R={R*100:.1f} см, h={h*100:.2f} см, витков={N_vitkov}, I={I} А\")\n",
        "\n",
        "    # Рассчитываем магнитное поле во всех точках сетки\n",
        "    # Результат: для каждой точки получаем вектор (Bx, By, Bz)\n",
        "    B_vectors = magnetic_field_spiral(R, h, N_vitkov, I, points)\n",
        "\n",
        "    # Вычисляем модуль (длину) вектора для каждой точки - это величина поля\n",
        "    # np.linalg.norm с axis=1 вычисляет длину каждого вектора в массиве\n",
        "    B_magnitude = np.linalg.norm(B_vectors, axis=1)\n",
        "\n",
        "\n",
        "    # 2. Создание фигуры с четырьмя подграфиками\n",
        "\n",
        "    fig = plt.figure(figsize=(15, 12))  # размер фигуры 15×12 дюймов\n",
        "\n",
        "\n",
        "    # 3. Первый подграфик: геометрия спирали (3D вид)\n",
        "\n",
        "    ax1 = fig.add_subplot(221, projection='3d')  # 2x2 сетка, первая позиция, 3D оси\n",
        "\n",
        "    # Создаём детальную спираль для красивого отображения\n",
        "    t_plot = np.linspace(0, 2*np.pi*N_vitkov, 200)  # 200 точек для плавной линии\n",
        "    x_spiral = R * np.cos(t_plot)\n",
        "    y_spiral = R * np.sin(t_plot)\n",
        "    z_spiral = h * t_plot\n",
        "\n",
        "    # Рисуем спираль красной линией толщиной 3 пикселя\n",
        "    ax1.plot(x_spiral, y_spiral, z_spiral, 'r-', linewidth=3, label=f'Спираль (I={I}A)')\n",
        "\n",
        "    # Настраиваем внешний вид\n",
        "    ax1.set_title('Геометрия спирали')\n",
        "    ax1.set_xlabel('X, м')\n",
        "    ax1.set_ylabel('Y, м')\n",
        "    ax1.set_zlabel('Z, м')\n",
        "    ax1.legend()\n",
        "\n",
        "\n",
        "    # 4. Второй подграфик: карта поля в плоскости XY (вид сверху)\n",
        "\n",
        "    ax2 = fig.add_subplot(222)\n",
        "\n",
        "    # Извлекаем срез данных при z=0 (середина по Z)\n",
        "    # reshape превращает одномерный массив обратно в 3D сетку\n",
        "    # grid_size//2 - индекс центрального слоя по Z (где z=0)\n",
        "    Z_slice = B_magnitude.reshape(grid_size, grid_size, grid_size)[:, :, grid_size//2]\n",
        "\n",
        "    # Строим цветную контурную карту\n",
        "    # contourf - заливка цветом, levels=20 - 20 уровней яркости\n",
        "    # .T нужно для правильной ориентации (транспонирование)\n",
        "    im2 = ax2.contourf(x, y, Z_slice.T, levels=20, cmap='hot')  # hot - от чёрного к жёлтому\n",
        "\n",
        "    # Добавляем белые контурные линии поверх для лучшей читаемости\n",
        "    ax2.contour(x, y, Z_slice.T, levels=10, colors='white', alpha=0.5)\n",
        "\n",
        "    # Добавляем цветовую шкалу\n",
        "    plt.colorbar(im2, ax=ax2, label='Магнитная индукция, Тл (Тесла)')\n",
        "\n",
        "    ax2.set_title('Распределение |B| в плоскости XY (z=0)')\n",
        "    ax2.set_xlabel('X, м')\n",
        "    ax2.set_ylabel('Y, м')\n",
        "\n",
        "    # 5. Третий подграфик: векторное поле в сечении XZ\n",
        "    #    Показываем направление магнитных силовых линий\n",
        "\n",
        "    ax3 = fig.add_subplot(223)\n",
        "\n",
        "    # Для наглядности берём каждый второй индекс по X и Z\n",
        "    x_indices = np.arange(0, grid_size, 2)  # индексы для X: 0,2,4,...\n",
        "    z_indices = np.arange(0, grid_size, 2)  # индексы для Z: 0,2,4,...\n",
        "    y_idx = grid_size // 2                   # индекс для Y=0 (середина)\n",
        "\n",
        "    # Перестраиваем массив векторов в 4D форму: (grid_size, grid_size, grid_size, 3)\n",
        "    # Теперь B_reshaped[i,j,k] - вектор поля в точке (x[i], y[j], z[k])\n",
        "    B_reshaped = B_vectors.reshape(grid_size, grid_size, grid_size, 3)\n",
        "\n",
        "    # Используем np.ix_ для выбора нужных индексов\n",
        "    # Выбираем: все z из z_indices, y только y_idx, все x из x_indices\n",
        "    B_slice = B_reshaped[np.ix_(z_indices, [y_idx], x_indices)]  # форма: (len(z_indices), 1, len(x_indices), 3)\n",
        "\n",
        "    # Извлекаем компоненты Bx (индекс 0) и Bz (индекс 2)\n",
        "    # Убираем измерение с размером 1 (y)\n",
        "    Bx_slice = B_slice[:, 0, :, 0]  # Bx для каждой точки (z,x)\n",
        "    Bz_slice = B_slice[:, 0, :, 2]  # Bz для каждой точки (z,x)\n",
        "\n",
        "    # Создаём сетку координат для отображения стрелок\n",
        "    X_slice, Z_slice = np.meshgrid(x[x_indices], z[z_indices])\n",
        "\n",
        "    # Рисуем стрелки (векторы) функцией quiver\n",
        "    # stride=2 дополнительно прореживает для наглядности\n",
        "    stride = 2\n",
        "    ax3.quiver(X_slice[::stride, ::stride], Z_slice[::stride, ::stride],\n",
        "               Bx_slice[::stride, ::stride], Bz_slice[::stride, ::stride],\n",
        "               scale=1e-5, color='blue')  # scale регулирует длину стрелок\n",
        "\n",
        "    ax3.set_title('Векторное поле B в сечении XZ (стрелки показывают направление)')\n",
        "    ax3.set_xlabel('X, м')\n",
        "    ax3.set_ylabel('Z, м')\n",
        "\n",
        "\n",
        "    # 6. Четвёртый подграфик: поле вдоль оси спирали\n",
        "\n",
        "    ax4 = fig.add_subplot(224)\n",
        "\n",
        "    # Создаём 100 точек вдоль оси Z (x=0, y=0)\n",
        "    z_axis = np.linspace(-0.02, 0.02, 100)\n",
        "    points_axis = np.column_stack((np.zeros(100), np.zeros(100), z_axis))\n",
        "\n",
        "    # Считаем поле в этих точках\n",
        "    B_axis = magnetic_field_spiral(R, h, N_vitkov, I, points_axis, 200)\n",
        "\n",
        "    # Переводим в микроТесла для удобства (1 Тл = 1 000 000 мкТл)\n",
        "    # Поле Земли ~50 мкТл, для сравнения\n",
        "    Bz_axis = np.linalg.norm(B_axis, axis=1) * 1e6\n",
        "\n",
        "    # Рисуем график: Z в сантиметрах, |B| в мкТл\n",
        "    ax4.plot(z_axis*100, Bz_axis, 'g-', linewidth=2, label='|B| вдоль оси Z')\n",
        "    ax4.set_xlabel('Z, см')\n",
        "    ax4.set_ylabel('|B|, мкТл')\n",
        "    ax4.set_title('Магнитное поле вдоль оси спирали')\n",
        "    ax4.grid(True)  # добавляем сетку\n",
        "    ax4.legend()\n",
        "\n",
        "\n",
        "    # 7. Настройка и сохранение\n",
        "\n",
        "    plt.tight_layout()  # автоматически подгоняем расположение графиков\n",
        "\n",
        "    # Сохраняем в файл с высоким разрешением\n",
        "    plt.savefig('magnetic_field_spiral.png', dpi=300, bbox_inches='tight')\n",
        "    print(\"График сохранён в файл 'magnetic_field_spiral.png'\")\n",
        "\n",
        "    # Показываем окно с графиками\n",
        "    plt.show()\n",
        "\n",
        "    # Выводим численные результаты в консоль\n",
        "    print(f\"Максимальная магнитная индукция в исследуемой области: {np.max(B_magnitude)*1e6:.1f} мкТл\")\n",
        "    print(f\"Индукция в центре (z=0): {Bz_axis[len(Bz_axis)//2]:.1f} мкТл\")\n",
        "    print(f\"Для сравнения: магнитное поле Земли ~ 50 мкТл\")\n",
        "\n",
        "\n",
        "# Запуск программы\n",
        "# Задаём параметры спирали (в метрах)\n",
        "R = float(input('Введите радиус (в метрах (пример 0.02))'))       # радиус 2 см (примерно как пальчиковая батарейка)\n",
        "h = float(input('Введите шаг (в метрах)'))      # шаг 0.5 см (полсантиметра между витками)\n",
        "N_vitkov = int(input('Введите количество витков'))   # 3 витка\n",
        "I = float(input('Введите значение тока'))          # ток 5 А (как в заряднике для ноутбука)\n",
        "\n",
        "# Вызываем главную функцию\n",
        "plot_magnetic_field(R, h, N_vitkov, I)"
      ],
